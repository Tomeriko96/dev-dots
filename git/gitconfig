[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	side-by-side = true
	line-numbers = true

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default

[alias]
	st  = status -sb
	d   = diff
	ds  = diff --staged
	lg  = log --oneline --graph --decorate --all
	co  = checkout
	br  = branch -vv
	ci  = commit
	undo = reset HEAD~1 --mixed
	aliases = config --get-regexp alias

[pull]
	rebase = true

[init]
	defaultBranch = main

[color]
	ui = auto

[rebase]
	autoStash = true
