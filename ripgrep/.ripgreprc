# ripgrep configuration
# This file is loaded from $RIPGREP_CONFIG_PATH

# Smart case: case-insensitive unless pattern has uppercase
--smart-case

# Search hidden files and directories (e.g. .gitignore, .bashrc)
--hidden

# Follow symbolic links
--follow

# Show line numbers
--line-number

# Use colors
--color=auto

# Ignore .git directories even when searching hidden files
--glob=!.git/

# Max columns (avoid very long lines cluttering output)
--max-columns=150
--max-columns-preview
