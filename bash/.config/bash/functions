# =====================
# Onboarding Wizard
# =====================
onboard() {
  # Run the wizard script to set up authentication and configuration.
  local script="$HOME/.onboard.sh"
  if [[ ! -f "$script" ]]; then
    echo "[onboard] Wizard script not found at $script" >&2
    return 1
  fi
  bash "$script" "$@"
}

# =====================
# Compression & Archiving
# =====================
compress() { tar -czf "${1%/}.tar.gz" "${1%/}"; }

extract() {
  if [ -z "$1" ]; then
    echo "Usage: extract <archive>" >&2
    return 1
  fi
  if [ ! -f "$1" ]; then
    echo "'$1' is not a file" >&2
    return 1
  fi
  case "$1" in
    *.tar.gz|*.tgz)   tar -xzf "$1" ;;
    *.tar.bz2|*.tbz2) tar -xjf "$1" ;;
    *.tar.xz)         tar -xJf "$1" ;;
    *.tar)            tar -xf  "$1" ;;
    *.zip)            unzip    "$1" ;;
    *.gz)             gunzip   "$1" ;;
    *.bz2)            bunzip2  "$1" ;;
    *.xz)             unxz     "$1" ;;
    *) echo "Cannot extract '$1': unsupported format" >&2; return 1 ;;
  esac
}
# Usage: extract <archive> - auto-detect the format and extract it (counterpart of compress)

# =====================
# Interactive Content Search
# =====================
rgf() {
  if [ "$#" -eq 0 ]; then
    echo "Usage: rgf <pattern> [rg options]" >&2
    return 1
  fi
  local result
  result=$(
    rg --color=always --line-number --no-heading "$@" 2>/dev/null |
      fzf --ansi \
          --delimiter ':' \
          --preview 'batcat --color=always --style=numbers --highlight-line {2} {1}' \
          --preview-window 'up,60%,border-bottom,+{2}+3/3,~3'
  )
  [ -n "$result" ] && echo "$result"
}
# Usage: rgf <pattern> - ripgrep search with a bat preview in fzf; prints the selected file:line:text

# =====================
# CSV Exploration Helper
# =====================
csvlens() {
  if [ "$#" -eq 0 ]; then
    local file
    file=$(fdfind . . --type f --extension csv | fzf --prompt='CSV file> ')
    [ -n "$file" ] && command csvlens "$file"
  else
    command csvlens "$@"
  fi
}
# Usage: csvlens (fuzzy-pick CSV), csvlens file.csv (direct open)

# =====================
# Shell & History Utilities
# =====================
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf "\U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}
__fzf_history__() {
  local selected
  selected=$(history | awk '{sub(/^[ \t]*[0-9]+[ \t]*/, ""); if (!seen[$0]++) print}' | fzf --tac --preview 'echo {}' | sed 's/ *[0-9]* *//')
  if [ -n "$selected" ]; then
    READLINE_LINE="$selected"
    READLINE_POINT=${#READLINE_LINE}
  fi
}
bind -x '"\C-r": __fzf_history__'
# =====================
# GitHub Clone Helper
# =====================
gclone() {
  local owner repo
  owner="${1:-$GITHUB_USER}"   # optional: pass user/org; default: your login

  if [ -z "$owner" ]; then
    owner="$(gh api user --jq '.login')" || return 1
  fi

  repo="$(
    gh repo list "$owner" \
      --limit 1000 \
      --json nameWithOwner,description \
      --jq '.[] | "\(.nameWithOwner)\t\(.description // "")"' |
    fzf --prompt="Select repo to clone: " \
        --with-nth=1,2 \
        --delimiter='\t' \
        --ansi |
    cut -f1
  )" || return 1

  [ -z "$repo" ] && echo "No repo selected" && return 1

  gh repo clone "$repo"

  local dir="${repo##*/}"
  if cd "$dir" 2>/dev/null; then
    onefetch 2>/dev/null || true
    tokei 2>/dev/null || true
  fi
}

